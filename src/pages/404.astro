---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Sidebar from '../components/Sidebar.astro'
---

<Base
  title="Page not found - Samy Tamim"
  description="That page does not exist on samytamim.com."
  path="/404/"
>
  <Nav />
  <div class="page-wrap active">
    <div class="page-inner">
      <div class="content-area">
        <div class="breadcrumb"><span>~ / </span>404</div>

        <h2 class="section-title">Page not found</h2>
        <p class="bio">That page doesn't exist. Try the <a class="nav-link" href="/">home page</a>, or browse the
          <a class="nav-link" href="/projects/">projects</a> and <a class="nav-link" href="/blog/">blog</a>.</p>
      </div>
      <Sidebar />
    </div>
  </div>
</Base>
