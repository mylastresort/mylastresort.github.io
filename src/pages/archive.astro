---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Sidebar from '../components/Sidebar.astro'
import { recentPosts } from '../data/site.js'
---

<Base
  title="Archive - Samy Tamim"
  description="Everything Samy Tamim has written: articles on machine learning, signal processing and brain-computer interfaces."
  path="/archive/"
>
  <Nav />
  <div class="page-wrap active">
    <div class="page-inner">
      <div class="content-area">
        <div class="breadcrumb"><span>~ / </span>archive</div>

        <div class="archive-year">
          <h3>2026</h3>
          <ul class="archive-list">
            {recentPosts.map((post) => (
              <li>
                <span class="date">{post.date}</span>
                <a class="nav-link" href={'/' + post.id + '/'}>{post.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <Sidebar />
    </div>
  </div>
</Base>
