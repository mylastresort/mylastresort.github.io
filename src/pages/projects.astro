---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Sidebar from '../components/Sidebar.astro'
import { projects } from '../data/projects.js'
---

<Base
  title="Projects - Samy Tamim"
  description="Things Samy Tamim has built: Gomoku, an AI opponent for five-in-a-row, and Music Room, a shared listening room."
  path="/projects/"
>
  <Nav />
  <div class="page-wrap active">
    <div class="page-inner">
      <div class="content-area">
        <div class="breadcrumb"><span>~ / </span>projects</div>

        <div class="project-grid">
          {projects.map((project) => (
            <article class={'project-card' + (project.status !== 'live' ? ' is-teaser' : '')}>
              <div class="project-preview">
                <img
                  src={project.preview}
                  alt={project.title + ' preview'}
                  loading="lazy"
                  width="16"
                  height="10"
                />
                {project.status !== 'live' && <span class="project-flag">coming soon</span>}
              </div>

              <div class="project-body">
                <div class="project-header">
                  <h3 class="project-title">
                    <a
                      class="project-title-link"
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >{project.title}</a>
                    <span class="project-arrow" aria-hidden="true">→</span>
                  </h3>
                  {project.source && (
                    <a
                      class="project-source-button"
                      href={project.source}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Source code for ${project.title} on GitHub`}
                      title="View source on GitHub"
                    >
                      <svg class="project-source-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                        <path
                          fill="currentColor"
                          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                        />
                      </svg>
                      <span class="project-source-label">Source</span>
                    </a>
                  )}
                </div>
                <p class="project-desc">{project.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
      <Sidebar />
    </div>
  </div>
</Base>
