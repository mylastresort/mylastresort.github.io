---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Sidebar from '../components/Sidebar.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { projects, series } from '../data/projects.js'

// Order: Gomoku, Music Room, then AI-native engineering series (IoC, IoW, Agent Smith).
const ordered = []
const seen = new Set()

for (const project of projects) {
  if (project.series) continue
  if (!seen.has(project.id)) {
    ordered.push(project)
    seen.add(project.id)
  }
}

for (const group of series) {
  const items = projects
    .filter((project) => project.series?.id === group.id)
    .sort((a, b) => a.series.part - b.series.part)
  for (const item of items) {
    if (!seen.has(item.id)) {
      ordered.push(item)
      seen.add(item.id)
    }
  }
}
---

<Base
  title="Projects - Samy Tamim"
  description="Things Samy Tamim has built: the AI-native engineering series (Inception-of-Context, Inception-of-Wisdom, Agent Smith), Gomoku, and Music Room."
  path="/projects/"
>
  <Nav />
  <div class="page-wrap active">
    <div class="page-inner">
      <div class="content-area">
        <div class="breadcrumb"><span>~ / </span>projects</div>

        <div class="project-grid">
          {ordered.map((project) => {
            const group = project.series ? series.find((s) => s.id === project.series.id) : null
            return <ProjectCard project={project} series={group} />
          })}
        </div>
      </div>
      <Sidebar />
    </div>
  </div>
</Base>
