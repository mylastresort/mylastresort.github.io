---
import { statusLabels } from '../data/projects.js'

const { project, series: group } = Astro.props
const { title, description, status = 'live', preview, source, url } = project

const href = url
const flag = statusLabels[status] ?? null
const isTeaser = status === 'coming-soon'
const part = project.series?.part
const total = group?.total
---

<article
  class:list={[
    'project-card',
    {
      'is-teaser': isTeaser,
      'is-static': !href,
      'has-link': Boolean(href),
    },
  ]}
>
  <div class:list={['project-preview', { 'project-preview--placeholder': !preview }]}>
    {preview ? (
      <img
        src={preview}
        alt={title + ' preview'}
        loading="lazy"
        width="16"
        height="10"
      />
    ) : (
      <div class="project-placeholder" aria-hidden="true">
        {group ? (
          <>
            <span class="project-placeholder-count">
              <span class="project-placeholder-part">{String(part).padStart(2, '0')}</span>
            </span>
            <span class="project-placeholder-watermark">{group.name}</span>
          </>
        ) : (
          <span class="project-placeholder-series">{title}</span>
        )}
      </div>
    )}

    {flag && <span class="project-flag">{flag}</span>}
  </div>

  <div class="project-body">
    <div class="project-header">
      <div class="project-title-group">
        <h3 class="project-title">
          {href ? (
            <a
              class="project-title-link"
              href={href}
              target="_blank"
              rel="noopener noreferrer"
            >{title}</a>
          ) : (
            <span class="project-title-text">{title}</span>
          )}
          {href && <span class="project-arrow" aria-hidden="true">→</span>}
        </h3>
        {group && (
          <p class="project-meta">{group.name}</p>
        )}
      </div>
      {source && (
        <a
          class="project-source-button"
          href={source}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Source code for ${title} on GitHub`}
          title="View source on GitHub"
        >
          <svg class="project-source-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"
            />
          </svg>
          <span class="project-source-label">Source</span>
        </a>
      )}
    </div>

    <p class="project-desc">{description}</p>
  </div>
</article>
