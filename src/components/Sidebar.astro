---
import { contactLinks } from '../data/site.js'
import photo from '../assets/photo.jpg'
---

<aside class="sidebar">
  <div class="photo-slot">
    <div class="photo-frame">
      <img class="sidebar-photo" src={photo.src} alt="profile photo" />
    </div>
  </div>
  <ul class="sidebar-links">
    {contactLinks.map((link) => (
      <li>
        <a
          href={link.href}
          aria-label={link.label}
          {...link.href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener noreferrer' }}
        ><span class="icon" set:html={link.icon}></span><span class="link-label">{link.label}</span></a>
      </li>
    ))}
  </ul>
</aside>

<script>
  // Hover-tilt for the profile photo. On hover the frame is switched to
  // position: fixed (see .photo-frame.photo-fixed) so it tracks the cursor
  // without affecting layout; scrolling detaches it.
  const frame = document.querySelector('.photo-frame');
  if (frame) {
    let hovering = false;
    let pending = false;

    const detach = () => {
      hovering = false;
      pending = false;
      frame.classList.remove('photo-fixed');
      frame.style.left = '';
      frame.style.top = '';
      frame.style.transition = 'transform 250ms ease-out';
      frame.style.setProperty('--rx', '0deg');
      frame.style.setProperty('--ry', '0deg');
      window.removeEventListener('scroll', detach, true);
    };

    frame.addEventListener('mouseenter', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      hovering = true;
      const rect = frame.getBoundingClientRect();
      frame.style.left = rect.left + 'px';
      frame.style.top = rect.top + 'px';
      frame.classList.add('photo-fixed');
      window.addEventListener('scroll', detach, true);
    });

    frame.addEventListener('mousemove', (e) => {
      if (!hovering || pending) return;
      pending = true;

      requestAnimationFrame(() => {
        if (!hovering) {
          pending = false;
          return;
        }
        const rect = frame.getBoundingClientRect();
        const px = (e.clientX - rect.left) / rect.width;
        const py = (e.clientY - rect.top) / rect.height;
        frame.style.transition = 'transform 60ms linear';
        frame.style.setProperty('--rx', (py - 0.5) * 18 + 'deg');
        frame.style.setProperty('--ry', (0.5 - px) * 20 + 'deg');
        pending = false;
      });
    });

    frame.addEventListener('mouseleave', detach);
  }
</script>
